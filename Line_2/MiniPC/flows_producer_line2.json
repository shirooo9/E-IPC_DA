    {
        "id": "9de08c64754e1fdc",
        "type": "function",
        "z": "ffceba5a227c1800",
        "d": true,
        "g": "840b6e718f6b5c67",
        "name": "Parsing_Scale",
        "func": "let rawLine = msg.payload.toString();\n\n// Fungsi bantuan untuk Regex\nconst extract = (text, regex) => {\n    let match = text.match(regex);\n    return match ? match[1].trim() : null;\n};\n\n// 1. Simpan Header ke Memori Jangka Panjang (Context)\n// Karena header cuma muncul sekali di awal, kita simpan di memori node \n// agar bisa dipakai berulang kali saat baris berat (1, 2, 3) muncul belakangan.\n\nlet matchType = extract(rawLine, /^Type\\s+(.+)/);\nif (matchType) context.set('scale_type', matchType);\n\nlet matchSNR = extract(rawLine, /^SNR\\s+(.+)/);\nif (matchSNR) context.set('scale_snr', matchSNR);\n\nlet matchBN = extract(rawLine, /^BN\\s+(.+)/);\nif (matchBN) context.set('scale_bn', matchBN);\n\n// 2. Tangkap Baris Berat (Contoh: \"  1  N       0.9840 g\")\n// Regex ini menangkap angka urutan (time_series) dan angka berat (weight)\nlet matchWeight = rawLine.match(/^\\s*(\\d+)\\s+[A-Za-z]\\s+([0-9.]+)\\s*g/);\n\nif (matchWeight) {\n    let time_series = parseInt(matchWeight[1]);\n    let weight_value = parseFloat(matchWeight[2]);\n\n    // Tarik data header dari memori (kalau kosong, isi \"Unknown\")\n    let instrument_code = context.get('scale_type') || \"Unknown\";\n    let snr_unit = context.get('scale_snr') || \"Unknown\";\n    let batch_number = context.get('scale_bn') || \"Unknown\";\n\n    // Generate Waktu Real-time\n    let now = new Date();\n    let created_date = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');\n    let created_time = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0') + ':' + String(now.getSeconds()).padStart(2, '0');\n\n    // 3. Tembak Payload ke MQTT\n    msg.payload = {\n        created_date: created_date,\n        created_time: created_time,\n        instrument_code: instrument_code,\n        snr_unit: snr_unit,\n        batch_number: batch_number,\n        time_series: time_series,\n        weight_value: weight_value,\n        status: 'N'\n    };\n\n    return msg;\n}\n\n// 4. Bersihkan Memori jika Struk Selesai (Trigger: ====)\nif (rawLine.includes(\"========================\")) {\n    context.set('scale_type', null);\n    context.set('scale_snr', null);\n    context.set('scale_bn', null);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
