    {
        "id": "5081a5300a5511d3",
        "type": "function",
        "z": "60fec81f96309e5d",
        "g": "7047f92b313ecd69",
        "name": "Parsing_Hardness",
        "func": "let lines = msg.payload.toString().split('\\n');\n\n// Jaring Pengaman: Pastikan ini format dari PTB32\nif (!msg.payload.toString().includes(\"Tolerance assessment\")) return null;\n\nlet batch = \"Unknown\", operator = \"Unknown\", product = \"Unknown\", method = \"Unknown\";\nlet date_val = \"\", time_val = \"\";\nlet dataTablets = [];\n\n// 1. Looping untuk membaca teks baris per baris\nfor (let i = 0; i < lines.length; i++) {\n    // Membaca nilai dari 1 baris di atas label sesuai struktur TXT PDFCreator\n    if (lines[i].includes(\"Batch:\")) batch = lines[i - 1].trim();\n    if (lines[i].includes(\"User:\")) operator = lines[i - 1].trim();\n    if (lines[i].includes(\"Product:\")) product = lines[i - 1].trim();\n    if (lines[i].includes(\"Method:\")) method = lines[i - 1].trim();\n    if (lines[i].includes(\"Date:\")) date_val = lines[i - 1].trim();\n    if (lines[i].includes(\"Time:\")) time_val = lines[i - 1].trim();\n\n    // Regex menangkap baris data: \"1 * 15,30* 20,21* 4,71\"\n    let match = lines[i].match(/^\\s*(\\d+)\\s*\\*\\s*(\\d+,\\d+)\\*?\\s+(\\d+,\\d+)\\*?\\s+(\\d+,\\d+)/);\n    if (match) {\n        dataTablets.push({\n            time_series: parseInt(match[1]),\n            hardness_kp: parseFloat(match[2].replace(',', '.')),\n            diameter_mm: parseFloat(match[3].replace(',', '.')),\n            thickness_mm: parseFloat(match[4].replace(',', '.'))\n        });\n    }\n}\n\n// 2. Urutkan data berdasarkan time_series dari terkecil ke terbesar\n// Lakukan ini SETELAH dataTablets terisi semua dari loop di atas\ndataTablets.sort((a, b) => a.time_series - b.time_series);\n\n// 3. Konversi format tanggal dari MM/DD/YYYY ke YYYY-MM-DD\nlet formatted_date = date_val;\nif (date_val.includes('/')) {\n    let d = date_val.split('/');\n    formatted_date = `${d[2]}-${d[0]}-${d[1]}`;\n}\n\n// 4. Format payload menjadi array of messages untuk dikirim satu per satu\nlet messages = [];\nfor (let tab of dataTablets) {\n    let payload = {\n        created_date: formatted_date,\n        created_time: time_val,\n        operator_name: operator,\n        instrument_code: \"PTB 311\",\n        product_name: product,\n        method_name: method,\n        batch_number: batch,\n        time_series: tab.time_series,\n        hardness_kp: tab.hardness_kp,\n        diameter_mm: tab.diameter_mm,\n        thickness_mm: tab.thickness_mm,\n        status: \"N\"\n    };\n    messages.push({ payload: payload });\n}\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
